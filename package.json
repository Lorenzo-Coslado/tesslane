{
  "name": "tesslane",
  "version": "0.1.0",
  "description": "A local swarm dashboard for planning, orchestrating and reviewing coding agents.",
  "author": "Lorenzo Coslado",
  "homepage": "https://github.com/Lorenzo-Coslado/tesslane#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorenzo-Coslado/tesslane.git"
  },
  "bugs": {
    "url": "https://github.com/Lorenzo-Coslado/tesslane/issues"
  },
  "keywords": [
    "agent-skills",
    "swarm",
    "codex",
    "claude-code",
    "local-first",
    "dashboard"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/cli.ts --foreground",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/cli.mjs --foreground",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests vite.config.ts",
    "format:check": "prettier --check src scripts tests vite.config.ts",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "preview": "tsx src/server/cli.ts --foreground --demo",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "license": "MIT"
}
