{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tesslane",
  "version": "0.1.0",
  "description": "Open-source, local-first AI coding agent dashboard for Codex and Claude Code. Coordinate multiple agents with Git worktrees, approvals and independent reviews.",
  "author": {
    "name": "Lorenzo Coslado",
    "url": "https://github.com/Lorenzo-Coslado"
  },
  "homepage": "https://github.com/Lorenzo-Coslado/tesslane",
  "repository": "https://github.com/Lorenzo-Coslado/tesslane",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "ai-coding",
    "agent-orchestration",
    "multi-agent",
    "codex",
    "openai-codex",
    "claude-code",
    "agent-skills",
    "git-worktrees",
    "local-first",
    "developer-tools",
    "dashboard",
    "swarm"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Tesslane",
        "shortDescription": "Your coding swarm, in one local workspace.",
        "developerName": "Lorenzo Coslado",
        "category": "Developer Tools",
        "brandColor": "#AFA8CB",
        "composerIcon": "./public/tesslane.png",
        "logo": "./public/tesslane.png"
      }
    }
  }
}
